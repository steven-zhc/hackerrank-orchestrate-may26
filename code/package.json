{
  "name": "hr-triage-agent",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "hr": "bin/hr.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx --env-file=.env.local src/main.ts",
    "test:corpus": "tsx --env-file=.env.local src/corpus/test-corpus.ts",
    "test:io": "tsx --env-file=.env.local src/io/test-io.ts",
    "validate": "tsx --env-file=.env.local src/io/validate.ts",
    "test:cache": "tsx --env-file=.env.local src/corpus/test-cache.ts",
    "build:index": "tsx --env-file=.env.local src/corpus/build-index.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "@langchain/openai": "^0.4.9",
    "csv-parse": "^5.6",
    "csv-stringify": "^6.5",
    "effect": "^3.12",
    "langchain": "^0.3.37",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19",
    "typescript": "^5.7"
  }
}
